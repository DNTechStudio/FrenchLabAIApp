{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AiImprovementResponse",
  "type": "object",
  "required": ["improvedText", "pedagogicalNotes", "overallFeedback"],
  "properties": {
    "improvedText": {
      "type": "string",
      "description": "The complete French essay elevated to DELF B2 standard"
    },
    "pedagogicalNotes": {
      "type": "array",
      "description": "List of pedagogical explanations mapped to DELF B2 criteria",
      "items": {
        "type": "object",
        "required": ["id", "criterion", "title", "improvedExcerpt", "explanation"],
        "properties": {
          "id": { "type": "string" },
          "criterion": {
            "type": "string",
            "enum": ["sociolinguistic", "coherence", "grammar", "vocabulary"]
          },
          "title": { "type": "string" },
          "originalExcerpt": { "type": "string" },
          "improvedExcerpt": { "type": "string" },
          "explanation": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "overallFeedback": {
      "type": "string",
      "description": "Synthesis of the candidate's essay strengths and key recommendations for DELF B2"
    }
  },
  "additionalProperties": false
}
